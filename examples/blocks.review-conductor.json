{
  "schema": "review-conductor.target.v1",
  "repository": "dinkuskit/blocks",
  "default_branch": "main",
  "ci": {
    "workflow_name": "CI",
    "workflow_path": ".github/workflows/ci.yml"
  },
  "review": {
    "quiet_seconds": 600,
    "scope": "comprehensive",
    "rails": [
      "openclaw",
      "clawsweeper"
    ]
  },
  "merge_policy": "human_only"
}
