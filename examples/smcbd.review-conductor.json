{
  "schema": "review-conductor.target.v2",
  "repository": "saari-co/openclaw-smcbd-suite",
  "default_branch": "main",
  "ci": {
    "workflow_name": "Exact-head review pipeline",
    "workflow_path": ".github/workflows/ci.yml"
  },
  "review": {
    "clawsweeper_requires_ready": true,
    "scope": "comprehensive",
    "rails": [
      "openclaw",
      "clawsweeper"
    ]
  },
  "merge_policy": "human_only"
}
